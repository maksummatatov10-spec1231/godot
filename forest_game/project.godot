config_version=5

[application]
config/name="WARDEN — The Emerald Wild"
run/main_scene="res://world.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
textures/default_filters/anisotropic_filtering_level=2
renderer/rendering_method="forward_plus"
rendering_device/fallback_to_opengl3=false
anti_aliasing/quality/msaa_3d=1
textures/default_filters/use_nearest_mipmap_filter=false
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
anti_aliasing/quality/screen_space_aa=1

environment/defaults/default_clear_color=Color(0.16, 0.24, 0.22, 1)

[physics]
common/physics_ticks_per_second=60
common/physics_interpolation=true
