[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]
linux.debug.x86_64 = "res://native/bin/libgame_native.so"
linux.release.x86_64 = "res://native/bin/libgame_native.so"
windows.debug.x86_64 = "res://native/bin/game_native.dll"
windows.release.x86_64 = "res://native/bin/game_native.dll"
macos.debug = "res://native/bin/libgame_native.dylib"
macos.release = "res://native/bin/libgame_native.dylib"
