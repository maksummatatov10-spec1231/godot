; Independent 2D project. Open this file in Godot 4.7.2.
config_version=5

[application]
config/name="Фонарщик — Тихая долина"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="A quiet village, an old traveller, and the light between the trees."

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.12,0.19,0.18,1)
2d/snap/snap_2d_transforms_to_pixel=true

[audio]
driver/enable_input=false

[debug]
gdscript/warnings/shadowed_variable_base_class=2
gdscript/warnings/integer_division=2
