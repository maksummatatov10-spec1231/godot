; Independent 2D project. Open this file in Godot 4.7.2.
config_version=5

[application]
config/name="Фонарщик — Тихая долина"
config/version="0.4.0"
config/icon="res://assets/app-icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="LanternValley"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="A quiet village, an old traveller, and the light between the trees."

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/size/min_width=960
window/size/min_height=540
window/handheld/orientation=4
window/vsync/vsync_mode=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.12,0.19,0.18,1)
2d/snap/snap_2d_transforms_to_pixel=false

[audio]
driver/enable_input=false

[debug]
gdscript/warnings/shadowed_variable_base_class=2
gdscript/warnings/integer_division=2
gdscript/warnings/confusable_local_declaration=2

[shader_globals]
wind_time={
"type": "float",
"value": 0.0
}
light_rect={
"type": "vec4",
"value": Vector4(0, 0, 32, 32)
}

shadow_light={
"type": "vec4",
"value": Vector4(0.85, 0.48, 0.38, 0)
}

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[lantern]
platform="pc"
