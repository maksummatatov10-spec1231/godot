; Infrastructure lab, not a game design decision.
config_version=5

[application]
config/name="Godot Development Lab"
run/main_scene="res://scenes/lab.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[assets2godot]
offline_mode=true

[editor_plugins]
enabled=PackedStringArray("res://addons/terrain_3d/plugin.cfg", "res://addons/SunshineClouds2/plugin.cfg", "res://addons/assets2godot/plugin.cfg")

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="forward_plus"
rendering_device/fallback_to_opengl3=false
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_taa=false
scaling_3d/scale=1.0
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.09, 1)
